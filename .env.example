# ============================================================================
# BJFishing 环境变量示例
# ============================================================================
# 使用方法：
#   cp .env.example .env
#   填入实际值（带 API key 的项）
# 所有配置项都有代码默认值，无 .env 也能运行（LLM_BACKEND=json 模式）

# === LLM 后端 ===
# json   = 纯 JSON 结构化输出（默认，无需 LLM，开发期推荐）
# qwen   = 阿里云 Qwen API（需要 QWEN_API_KEY）
# ollama = 本地 Ollama（需要 Ollama 服务运行）
LLM_BACKEND=json

# Qwen API (阿里云 dashscope)
# 获取: https://dashscope.console.aliyun.com/
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Ollama (本地部署)
# 安装: https://ollama.ai/
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# === 地理编码 ===
# 高德地图 API key (优先使用，中文精度高)
# 获取: https://lbs.amap.com/
# 留空则 fallback 到 Nominatim（免费但中文精度一般）
GAODE_API_KEY=
NOMINATIM_USER_AGENT=BJFishing/0.1.0

# === Open-Meteo 气象 API ===
# 免费，无需 API key
# forecast: 未来 16 天预报
# archive:  历史 1940 年至今（ERA5 数据源）
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_DAILY_QUOTA=10000
WEATHER_CACHE_TTL=3600

# === 数据库 ===
FEEDBACK_DB_PATH=data/feedback.db

# === 日志 ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === MCP Server ===
MCP_SERVER_NAME=bjfishing
MCP_SERVER_VERSION=0.1.0
